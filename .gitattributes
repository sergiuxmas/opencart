# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must use LF on all platforms
*.sh text eol=lf
docker/php/docker-opencart-entrypoint text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary

