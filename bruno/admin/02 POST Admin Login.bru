meta {
  name: 02 POST Admin Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/index.php?route=common/login.login
  body: formUrlEncoded
  auth: none
}

params:query {
  login_token: {{admin_login_token}}
}

body:form-urlencoded {
  username: {{adminUsername}}
  password: {{adminPassword}}
}

script:post-response {
  // Response on success:  {"redirect":"http://...?route=common/dashboard&user_token=XYZ"}
  // Response on failure:  {"error":"Warning: No match for Username and/or Password."}
  const body = res.getBody();
  try {
    const data = JSON.parse(body);

    if (data.redirect) {
      const match = data.redirect.match(/user_token=([a-zA-Z0-9]+)/);
      if (match) {
        const token = match[1];

        // Used by hand-crafted admin requests ({{admin_user_token}})
        bru.setVar('admin_user_token', token);
        bru.setEnvVar('admin_user_token', token);

        // 'apiKey' = variable Bruno assigns to the userToken apiKey security scheme
        // imported from openapi.yaml → every admin endpoint appends user_token={{apiKey}}
        bru.setVar('apiKey', token);
        bru.setEnvVar('apiKey', token);

        console.log('✅ Admin login OK  |  user_token = apiKey = ' + token);
      }
    } else if (data.error) {
      console.error('❌ Admin login failed: ' + data.error);
    }
  } catch (e) {
    console.error('Could not parse response: ' + e.message);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains redirect with user_token", function() {
    const data = JSON.parse(res.getBody());
    expect(data).to.have.property('redirect');
    expect(data.redirect).to.include('user_token=');
  });

  test("No login error", function() {
    expect(res.getBody()).to.not.include('"error"');
  });
}
