            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion">
              <stringProp name="BeanShellAssertion.query">String expected = vars.get(&quot;productId&quot;);
String actual = vars.get(&quot;pageProductId&quot;);
String productName = vars.get(&quot;pageProductName&quot;);
String productBrand = vars.get(&quot;pageProductBrand&quot;);
String productCode = vars.get(&quot;pageProductCode&quot;);
String productAvailability = vars.get(&quot;pageProductAvailability&quot;);
String unitPrice = vars.get(&quot;pageUnitPriceAmount&quot;);
String minimumQuantity = vars.get(&quot;pageMinimumQuantity&quot;);

if (!expected.equals(actual)) {
    Failure = true;
    FailureMessage = &quot;Wrong product opened. Expected productId=&quot; + expected + &quot;, but pageProductId=&quot; + actual;
}

if (productName.equals(&quot;PRODUCT_NAME_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product name wasn&apos;t extracted&quot;;
}

if (productBrand.equals(&quot;PRODUCT_CODE_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product code wasn&apos;t extracted&quot;;
}

if (productCode.equals(&quot;PRODUCT_BRAND_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product brand wasn&apos;t extracted&quot;;
}

if (productAvailability.equals(&quot;PRODUCT_AVALABILITY_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product availability wasn&apos;t extracted&quot;;
}

if (unitPrice.equals(&quot;PRODUCT_UNIT_PRICE_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product unit price wasn&apos;t extracted&quot;;
}

if (minimumQuantity.equals(&quot;PRODUCT_QUANTITY_NOT_FOUND&quot;)){
	Failure = true;
    	FailureMessage = &quot;Product minimum quantity wasn&apos;t extracted&quot;;
}

log.info(&quot;pageProductName = &quot; + productName);
log.info(&quot;pageProductBrand = &quot; + productBrand);
log.info(&quot;pageProductCode = &quot; + productCode);
log.info(&quot;pageProductAvailability = &quot; + productAvailability);
log.info(&quot;pageUnitPriceAmount = &quot; + unitPrice);
log.info(&quot;pageMinimumQuantity = &quot; + minimumQuantity);
</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
          </hashTree>
