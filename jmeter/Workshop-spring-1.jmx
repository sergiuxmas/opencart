              <stringProp name="script">String cartQuantity = vars.get(&quot;purchase_quantity&quot;);

if (cartQuantity == null || cartQuantity.equals(&quot;&quot;)) {
    cartQuantity = &quot;1&quot;;
}

vars.put(&quot;cartQuantity&quot;, cartQuantity);</stringProp>
              <stringProp name="scriptLanguage">beanshell</stringProp>
            </JSR223PreProcessor>
