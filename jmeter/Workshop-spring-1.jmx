              <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion - cart count increased">
                <stringProp name="BeanShellAssertion.query">log.info(&quot;cartCountBefore = &quot; + vars.get(&quot;cartCountBefore&quot;));
log.info(&quot;cartCountAfter = &quot; + vars.get(&quot;cartCountAfter&quot;));

Integer cartCountBefore = Integer.valueOf(vars.get(&quot;cartCountBefore&quot;));
Integer cartCountAfter = Integer.valueOf(vars.get(&quot;cartCountAfter&quot;));

if (!cartCountAfter &gt; cartCountBefore) {
    Failure = true;
    FailureMessage = &quot;Cart counter hasn&apos;t changed. Expected count &gt; &quot; + cartCountBefore + &quot;, but actual count=&quot; + cartCountAfter;
}</stringProp>
